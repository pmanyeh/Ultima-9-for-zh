{"key":"text.flx:4039","resource":"text.flx","entry_id":4039,"status":"showcase-draft","category":"response","speaker":"Avatar","context":"Earth gypsy: greeting / journey / preparation / not-ready return branch","notes":null,"terms":[],"target":"我該做些什麼準備？","source_sha256":"3df7657665894a779ce13ca313379cc864614048d69775888a85962bb30edf87","source_units":28,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S2:composited","P6-S2:screenshot"],"migrated_from":"translation/showcase/gypsy-intro.zh-TW.json"}
{"key":"text.flx:4040","resource":"text.flx","entry_id":4040,"status":"showcase-draft","category":"response","speaker":"Avatar","context":"Earth gypsy: greeting / journey / preparation / not-ready return branch","notes":null,"terms":[],"target":"我準備好了！","source_sha256":"c43f530ffab41b9f43ffe217dcf763d14266b7efa96609fa29607d801d77856c","source_units":14,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S2:composited","P6-S2:screenshot"],"migrated_from":"translation/showcase/gypsy-intro.zh-TW.json"}
{"key":"text.flx:4041","resource":"text.flx","entry_id":4041,"status":"showcase-draft","category":"dialogue","speaker":"Gypsy","context":"Earth gypsy: greeting / journey / preparation / not-ready return branch","notes":null,"terms":["Britannia"],"target":"長久以來，你一直是 Britannia 的救星。","source_sha256":"8eec940fa9550e05134977ab6031f505748c1f60dbc0e51ee1dc9eef166ce858","source_units":43,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S2:composited","P6-S2:screenshot"],"migrated_from":"translation/showcase/gypsy-intro.zh-TW.json"}
{"key":"text.flx:4042","resource":"text.flx","entry_id":4042,"status":"showcase-draft","category":"dialogue","speaker":"Gypsy","context":"Earth gypsy: greeting / journey / preparation / not-ready return branch","notes":null,"terms":["Britannia"],"target":"過去你曾八度踏上這趟旅程，讓 Britannia 免於毀滅。","source_sha256":"d0a6ddf0bbf0aceb45e2e202e4d3e13337a875e1e27a610f6e571cfc52f7516e","source_units":87,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S2:composited","P6-S2:screenshot"],"migrated_from":"translation/showcase/gypsy-intro.zh-TW.json"}
{"key":"text.flx:4043","resource":"text.flx","entry_id":4043,"status":"showcase-draft","category":"dialogue","speaker":"Gypsy","context":"Earth gypsy: greeting / journey / preparation / not-ready return branch","notes":null,"terms":[],"target":"這一次，你必須徹底完成使命。","source_sha256":"d2307b67f068fe573b805abc454f60b6c510df217322ecb2e00ebd6832af4245","source_units":35,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S2:composited"],"migrated_from":"translation/showcase/gypsy-intro.zh-TW.json"}
{"key":"text.flx:4044","resource":"text.flx","entry_id":4044,"status":"showcase-draft","category":"dialogue","speaker":"Gypsy","context":"Earth gypsy: greeting / journey / preparation / not-ready return branch","notes":null,"terms":[],"target":"因為這趟旅程結束後，你將走向不同的未來。","source_sha256":"708ce3fa85a4846c384342e6bcd7ed0e9875d79423def03ff5eae202de7f8a70","source_units":61,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S2:composited","P6-S2:screenshot"],"migrated_from":"translation/showcase/gypsy-intro.zh-TW.json"}
{"key":"text.flx:4045","resource":"text.flx","entry_id":4045,"status":"showcase-draft","category":"dialogue","speaker":"Gypsy","context":"Earth gypsy: greeting / journey / preparation / not-ready return branch","notes":null,"terms":[],"target":"你已熟練戰鬥、游泳，以及裝備的使用方法了嗎？","source_sha256":"efd26a5347e5dc917d9725405a04de8cefc5c756c6c8903a0bbaba5a2ca81bfe","source_units":66,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S2:composited"],"migrated_from":"translation/showcase/gypsy-intro.zh-TW.json"}
{"key":"text.flx:4046","resource":"text.flx","entry_id":4046,"status":"showcase-draft","category":"response","speaker":"Avatar","context":"Earth gypsy: greeting / journey / preparation / not-ready return branch","notes":null,"terms":[],"target":"我還沒準備好。","source_sha256":"b1ae012000e195aa706cbdc8528ab0d766c4d3f689a7d9b0df985ae2dadfe5aa","source_units":19,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S2:composited","P6-S2:screenshot"],"migrated_from":"translation/showcase/gypsy-intro.zh-TW.json"}
{"key":"text.flx:4048","resource":"text.flx","entry_id":4048,"status":"showcase-draft","category":"response","speaker":"Avatar","context":"Earth gypsy: greeting / journey / preparation / not-ready return branch","notes":null,"terms":[],"target":"我已經準備好了！","source_sha256":"0f44c1f91c9bdbf6c1360a18ce81c107361ac3a8b60c394ff45cba9a5d9a7556","source_units":11,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S2:composited","P6-S2:screenshot"],"migrated_from":"translation/showcase/gypsy-intro.zh-TW.json"}
{"key":"text.flx:4050","resource":"text.flx","entry_id":4050,"status":"showcase-draft","category":"dialogue","speaker":"Gypsy","context":"Earth gypsy: greeting / journey / preparation / not-ready return branch","notes":null,"terms":[],"target":"準備好之後，再回來找我吧。","source_sha256":"01a9b3518bb767fb99e0b56d0eca0882367160bbbf582bee6f7f1314ee9e4d11","source_units":32,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S2:composited"],"migrated_from":"translation/showcase/gypsy-intro.zh-TW.json"}
{"key":"text.flx:4051","resource":"text.flx","entry_id":4051,"status":"showcase-draft","category":"dialogue","speaker":"Gypsy","context":"Earth gypsy: greeting / journey / preparation / not-ready return branch","notes":null,"terms":[],"target":"你得先探索這座森林。","source_sha256":"1f17850ba6bb0d8c8688fec2581bd97099289a2441c84ebd1fa4ba63b60730d4","source_units":34,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S2:composited"],"migrated_from":"translation/showcase/gypsy-intro.zh-TW.json"}
{"key":"text.flx:4052","resource":"text.flx","entry_id":4052,"status":"showcase-draft","category":"dialogue","speaker":"Gypsy","context":"Earth gypsy: greeting / journey / preparation / not-ready return branch","notes":null,"terms":["Britannia"],"target":"這裡有許多知識能在旅途中幫助你。前往 Britannia 之前，先\n學會游泳與戰鬥吧！","source_sha256":"d8b206c7ac1e2f69612751663dcfdc06c8cfd2e70604b97236aa9019baad3b47","source_units":143,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S2:composited","P6-S2:screenshot"],"migrated_from":"translation/showcase/gypsy-intro.zh-TW.json"}
{"key":"text.flx:4164","resource":"text.flx","entry_id":4164,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":["Avatar","Britannia","Guardian","Lord British"],"target":"Avatar，醒醒！Guardian 已入侵 Britannia。\nLord British 正召喚你，展開最後的冒險！","source_sha256":"8850732093f0d0f7ff7cc3ecc77abade7dc2a60e02b8fda757b3587c55dd4077","source_units":129,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S:composited","P6-S:screenshot"],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4166","resource":"text.flx","entry_id":4166,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"移動滑鼠就能環顧四周。想要走動時，按住滑鼠右鍵即可。","source_sha256":"1dd6f8c6ede472d829e2926a7693d697156d0e9fe60be361c8da9c17ed868b9c","source_units":119,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S:composited","P6-S:screenshot"],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4167","resource":"text.flx","entry_id":4167,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"你也能用游標與物品互動。\n靠得夠近時，把游標移到可使用的物品上，游標就會變成綠色。","source_sha256":"70dc371898c7e94c5d230f02719c654da9e0d7f98057a2719bdec29ed52a51cf","source_units":152,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S:composited","P6-S:screenshot"],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4168","resource":"text.flx","entry_id":4168,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"想使用物品，只要按一下滑鼠左鍵。","source_sha256":"58a5b50dd22ec56669ca1a675646f817da2e1c08059e2e378a782e37c8ebb0ed","source_units":59,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S:composited"],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4169","resource":"text.flx","entry_id":4169,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":["Ankh"],"target":"接下來，請用滑鼠左鍵點一下\n床邊出現的金色 Ankh，我會繼續指引你。","source_sha256":"82b5b97b1b89eb8c0d4797a90917874c39c8d54452612c9d802c3bd4c525f70a","source_units":89,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S:composited"],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4170","resource":"text.flx","entry_id":4170,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"首先，做好冒險的準備。離家之前，別忘了帶齊所有用品。","source_sha256":"5eb5f96dce768598eca5f2c25543ac5377da8633fabead102d3d0b517b8171cd","source_units":122,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S:composited","P6-S:screenshot"],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4171","resource":"text.flx","entry_id":4171,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"許多物品都能操作，不妨多試試。先試著打開房裡的燈吧。","source_sha256":"d283321cf09ee3b2df4778893b84dad208c454a9eea34bccbbcde065d2aa327d","source_units":127,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S:composited"],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4172","resource":"text.flx","entry_id":4172,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"走近電燈開關，把游標移到開關上，直到游標變綠。\n再按一下滑鼠左鍵，就能開燈或關燈。","source_sha256":"6f6558f0da56dac1d71a86ab4515b5dd22755ba07e5f4d35384e9cebc2e72f2d","source_units":165,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S:composited","P6-S:screenshot"],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4173","resource":"text.flx","entry_id":4173,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"我已標出幾樣值得留意的物品，記得仔細看看。","source_sha256":"575cab4c749da2fe79532d3d9dda7696e75b4e0c868e1d3ed5d48430887f2b6b","source_units":69,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S:composited","P6-S:screenshot"],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4174","resource":"text.flx","entry_id":4174,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"有了背包或工具腰帶，你就能把那件東西帶走了。","source_sha256":"ac73346d37f621bba1c3a873225b71b7a431e30851d708c84ffe725bae56afdb","source_units":76,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4175","resource":"text.flx","entry_id":4175,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"總不能不穿衣服就出門冒險吧。你的衣服應該在另一扇門後的浴室裡。","source_sha256":"c88531ee70224521e848e61bd3d4fc34a7a4ea7a527312f1c2e8208f54ffa479","source_units":117,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4176","resource":"text.flx","entry_id":4176,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"要穿上衣服，按住滑鼠左鍵，把衣服拖到自己身上，再放開按鍵就行了。","source_sha256":"586ff2ba73aa0e5e6aeb66fba27b9f5f5885722e933ec44705c0cc45b9440a05","source_units":130,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4177","resource":"text.flx","entry_id":4177,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":["Avatar"],"target":"Avatar，聽我的勸，帶上身旁桌上的工具腰帶吧！你會用得上的。","source_sha256":"d3dc7b28ca4c64fbe95a487d84697018815493e369abb8d5e1286ab7aa6d495c","source_units":78,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4178","resource":"text.flx","entry_id":4178,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"看看畫面下方的工具腰帶。\n放在這裡的物品，可以用滑鼠左鍵點選圖示，或按對應的功能鍵來使用。","source_sha256":"11671b9984dcefeb63f47abf4b52132ac756c68e7af2bec4d4458693f03e3166","source_units":180,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4179","resource":"text.flx","entry_id":4179,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"要把物品放進工具腰帶，按住滑鼠左鍵，將物品拖到想放的欄位即可。","source_sha256":"dc9e883dac5e2b5bd463ecc265dc83031c72a12645365aba24c72d328550f58a","source_units":83,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4180","resource":"text.flx","entry_id":4180,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"要取下工具腰帶上的物品，先按 Q 鍵，讓游標離開畫面中央，\n再把物品從腰帶上拖出來。","source_sha256":"3cf92c14c7f8611df7f3f3f6c75995869472667dc6214927a7db5712af87491e","source_units":151,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4181","resource":"text.flx","entry_id":4181,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"完成後，別忘了再按一次 Q 鍵，將游標固定回畫面中央。","source_sha256":"dd6fd11ef8bc1442420bc5cc3fae32ab45a917cb1a4c0280e6b326087cb462df","source_units":94,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4182","resource":"text.flx","entry_id":4182,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"按住滑鼠左鍵，把物品拖到背包圖示上，就能收進背包。\n按 B 鍵可查看背包裡的物品。","source_sha256":"4c2edff29d00c10367b9cae122a1aa3e0c6f44f425edfe2e427d007581746c65","source_units":140,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4183","resource":"text.flx","entry_id":4183,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"打開背包後，可以把裡面的物品拖出來，放到地上。\n對著背包按滑鼠右鍵，就能關閉背包。","source_sha256":"7532db201900a739e6b83d48b6112e6ec0bdb8b5efe66f8306aa80c0ff76b1a1","source_units":136,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4184","resource":"text.flx","entry_id":4184,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":["Avatar"],"target":"Avatar，你可以坐在椅子上，也能躺在床上。\n用滑鼠左鍵點椅子或沙發的座位就能坐下，床也是一樣。","source_sha256":"f0eb343c2ee1f0fe1cf589250f30fc18daf2c7fe5e4c04172c8f54b2ab5d3141","source_units":147,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4185","resource":"text.flx","entry_id":4185,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":["Avatar"],"target":"Avatar，別忘了帶工具腰帶再出門。到樓上的走廊找找吧。","source_sha256":"671f636b35ff3679418182e7943eddee7e34bca64f5e76cbdf24453f32f1597e","source_units":86,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4186","resource":"text.flx","entry_id":4186,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":["Avatar"],"target":"Avatar，別忘了帶背包再出門。我想你把它留在電腦房了。","source_sha256":"1e5dc75c628fb7d215a02d6cc1d400d8de405fb841219914d76d6c319051df0b","source_units":88,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4187","resource":"text.flx","entry_id":4187,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":["Avatar"],"target":"Avatar，別忘了帶指南針再出門。到壁爐附近找找吧。","source_sha256":"5f6e4f119c904ceb6ab88ef82f4b1838621eab376598a0fc17b0185ff9a3beea","source_units":79,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4188","resource":"text.flx","entry_id":4188,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":["Avatar"],"target":"Avatar，別忘了你的日誌。它就在客廳裡。","source_sha256":"32323844836b5ef80f9a4d54908f2a987f8310d0b9d20d0e6bc4c4b00a678b70","source_units":71,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4189","resource":"text.flx","entry_id":4189,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":["Britannia"],"target":"前往 Britannia 之前，你還有許多事要學。\n先到屋子西北邊的訓練區去吧。","source_sha256":"05280f8120f1c7e94bd71cb21443ecad84d1a253fe3c62735e68e90926ed0e43","source_units":123,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4190","resource":"text.flx","entry_id":4190,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"還記得跳房子嗎？你可能比自己想的更靈活。試著往各個方向移動吧。","source_sha256":"0eb7ccbd8de0ce3ff015e4109f2ed044bc4d8f6297bd9dd66d826dea0dbf7681","source_units":108,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4191","resource":"text.flx","entry_id":4191,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"按住滑鼠右鍵，同時按 Ctrl 或 Alt 鍵，\n試著走過跳房子的格子。三個按鍵一起按住，就能往後退。","source_sha256":"9c810274e6f3830d0f0462d400bafff96346a9382986d14ba342ca8bc2e259b7","source_units":165,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4192","resource":"text.flx","entry_id":4192,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"把游標移到想跳過去的位置，再按空白鍵，就能跳躍。","source_sha256":"ea76da20b9dbe96756353c23ae69c2ce2b6af856de88f10fa9fbdfdb18ffc14e","source_units":101,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4193","resource":"text.flx","entry_id":4193,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"跳之前，先估量距離。準星是綠色時，就能輕鬆跳到指定位置；\n否則可能太遠，無法順利跳過去。","source_sha256":"759fe7855d6c728e7deb2dbcdcae306752d8c61389c0378d50d6c34ff4b116ce","source_units":204,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4194","resource":"text.flx","entry_id":4194,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"把劍拖到自己身上就能裝備。\n按 Tab 鍵進入戰鬥模式，你就會拔出劍。","source_sha256":"5ddc56d39861ce8c4cecaf93c5299a4160b8e8c4f64ed5f36372d9d7ff448e60","source_units":126,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4195","resource":"text.flx","entry_id":4195,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"拔劍後，按滑鼠左鍵就能用劍刺擊。","source_sha256":"94de952c3fa7d97a5776442254e805eed1b25f74b79b87ab94071b887eedf463","source_units":95,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4196","resource":"text.flx","entry_id":4196,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"再按一次 Tab 鍵，就能收起武器。","source_sha256":"f82a08ac014bc5fb6c72858cb57609a054370cafabe5ed2dc94a8f56c535cc6e","source_units":46,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4197","resource":"text.flx","entry_id":4197,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"把弓拖到自己身上就能裝備。別忘了撿起旁邊的箭。","source_sha256":"dc9887b79c86e8dc2a4a15b51d97888fab637b5ad2f665c999f2dddc00818934","source_units":93,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4198","resource":"text.flx","entry_id":4198,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"按 Tab 鍵進入戰鬥模式，準備好弓。\n按住滑鼠左鍵拉弓，放開按鍵就能射箭。","source_sha256":"d8cb13590cbfb8366bb53bebc8b52d6a60c33533b93d84a8143179414b2134d4","source_units":174,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4199","resource":"text.flx","entry_id":4199,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"再按一次 Tab 鍵，就能解除備戰。","source_sha256":"e77247e164957db8f32c0ef30f640c0ef38b4147f5198adf7947dea0e9defb7f","source_units":47,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4200","resource":"text.flx","entry_id":4200,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"帶上書桌上的鑰匙了嗎？只要持有正確的鑰匙，就能自動打開上鎖的門。\n用過的鑰匙會留在鎖上。","source_sha256":"158779e11b15dc5af7c8d4a55e3656621d31f59c7645762d3f53186019ae13f6","source_units":159,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4201","resource":"text.flx","entry_id":4201,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"許多物體都能攀爬，像這根倒木就是。靠近後按 C 鍵，就能爬上去。","source_sha256":"3ae04b9eaa07a9881da255b83de6d5e49af318e683e12f20ddef78bbb2afac56","source_units":101,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4202","resource":"text.flx","entry_id":4202,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"游泳並不難。移動時往下看，就能下潛；往上看，就會游回水面。","source_sha256":"cba1d11234225009d471fea0fac8abff9d06dd1da0acf61555f25bcc9eb8849f","source_units":114,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}
{"key":"text.flx:4203","resource":"text.flx","entry_id":4203,"status":"showcase-draft","category":"subtitle","speaker":"Hawkwind","context":"Earth home / outdoor tutorial","notes":null,"terms":[],"target":"游泳時按住 Ctrl 或 Alt 鍵，就能側泳，甚至仰泳。","source_sha256":"dce3717ac9fda06a21778f5b6f007b356ef33aa9946d5fdb01e853ca2138a7f9","source_units":111,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":[],"migrated_from":"translation/showcase/opening.zh-TW.json"}

{"key":"text.flx:4035","resource":"text.flx","entry_id":4035,"status":"showcase-draft","category":"dialogue","speaker":"Gypsy","context":"Earth gypsy: greeting / journey / preparation / not-ready return branch","notes":null,"terms":[],"target":"若你踏上這趟旅程，","source_sha256":"0e647f5733f112df883031b5c854dbcf5e9ca85fc757571a232336c1c3b224ce","source_units":25,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S2:composited"],"migrated_from":"translation/showcase/gypsy-intro.zh-TW.json"}
{"key":"text.flx:4036","resource":"text.flx","entry_id":4036,"status":"showcase-draft","category":"dialogue","speaker":"Gypsy","context":"Earth gypsy: greeting / journey / preparation / not-ready return branch","notes":null,"terms":["Britannia"],"target":"便再也回不了地球，也不會再回到 Britannia。","source_sha256":"e143eb40eabfa1b3ca76e5cb3c06b21aab751b22c03adfc30b15718f68017c85","source_units":72,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S2:composited"],"migrated_from":"translation/showcase/gypsy-intro.zh-TW.json"}

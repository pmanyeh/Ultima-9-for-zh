{"key":"text.flx:4032","resource":"text.flx","entry_id":4032,"status":"showcase-draft","category":"dialogue","speaker":"Gypsy","context":"Earth gypsy: greeting / journey / preparation / not-ready return branch","notes":null,"terms":["Avatar","Britannia"],"target":"你好，Avatar；Britannia 正等著你。","source_sha256":"c48dc5be369c870bb6429117ebd5e14ec166818eda86e226dff3c68c0d6899b2","source_units":36,"review":{"terminology":false,"language":false,"runtime":false},"runtime_supported":null,"runtime_evidence":["P6-S2:composited"],"migrated_from":"translation/showcase/gypsy-intro.zh-TW.json"}
